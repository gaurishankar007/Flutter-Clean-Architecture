# Copy to fastlane/.env (gitignored) and fill in. Relative paths resolve from
# the project root; fastlane/keys/ is gitignored for storing the key files.

# Firebase App Distribution (Android) - same values as the GitHub secrets.
FIREBASE_SERVICE_ACCOUNT_FILE=fastlane/keys/firebase-service-account.json
FIREBASE_APP_ID_STAGING=
FIREBASE_APP_ID_PRODUCTION=

# App Store Connect API key (iOS signing + TestFlight upload).
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_PATH=fastlane/keys/AuthKey.p8
